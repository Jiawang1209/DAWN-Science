  "build": {
    "buildCommand": "cp src/electron/credentials.ts /tmp/credentials.ts.bak && python3 - <<'EOF'\np='src/electron/credentials.ts'; s=open(p).read()\ns=s.replace('    if (!data.encrypted) return raw\\n','    if (!data.encrypted) return raw\\n    console.error(\"[PROBE get]\", endpointId, new Error().stack?.split(\"\\\\n\").slice(2,14).join(\"\\\\n\"))\\n',1)\nopen(p,'w').write(s)\nEOF\nnpm run build:electron 2>&1 | tail -2 && cat > /tmp/probe.mjs <<'EOF'\nimport { _electron } from \"@playwright/test\"\nimport { mkdtempSync, mkdirSync, writeFileSync } from \"node:fs\"; import { tmpdir } from \"node:os\"; import { join } from \"node:path\"\nconst tmp=mkdtempSync(join(tmpdir(),\"dawn-probe-\")); const ud=join(tmp,\"ud\"); mkdirSync(ud)\nwriteFileSync(join(ud,\"credentials.json\"),JSON.stringify({encrypted:true,entries:{deepseek:Buffer.from(\"x\").toString(\"base64\")}}))\nconst env={...process.env}; for(const k of Object.keys(env)) if(k.startsWith(\"DAWN_\")||k.endsWith(\"_API_KEY\")) delete env[k]\nenv.DAWN_HIDE_WINDOW=\"1\"\nconst app=await _electron.launch({args:[\"dist/electron/main.js\",`--user-data-dir=${ud}`],env})\napp.process().stderr.on(\"data\",d=>{const t=d.toString(); if(t.includes(\"PROBE\")) process.stdout.write(t)})\nconst page=await app.firstWindow(); await page.locator(\".app-shell\").waitFor({timeout:30000}); await page.waitForTimeout(3000)\nawait app.close()\nEOF\nnode /tmp/probe.mjs 2>&1 | head -40; cp /tmp/credentials.ts.bak src/electron/credentials.ts && git diff --stat src/electron/credentials.ts | tail -1",
    "testCommand": "npm test 2>&1 | tail -6; echo \"=== FRESH ===\"; REHEARSE_REAL_HOME=1 node scripts/rehearse-fresh-install.mjs 2>&1 | grep -E \"✓|✗|慢|渲染错误|钥匙串|凭证\" | head -30",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "dist": "npm run build && electron-builder --publish never",
      "dist:mac": "npm run build && electron-builder --mac --publish never",
      "dist:win": "npm run build && electron-builder --win --publish never",
      "dist:linux": "npm run build && electron-builder --linux --publish never",
      "pack": "npm run build && electron-builder --dir",
      "test:packaged": "node scripts/test-packaged.mjs",
      "make-icon": "electron scripts/make-icon.mjs",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test --grep-invert \"内核会话|解释器路径\" && playwright test e2e/kernel-session.spec.ts",
      "test:e2e:only": "playwright test --grep-invert \"内核会话|解释器路径\"",
      "test:e2e:kernel": "playwright test e2e/kernel-session.spec.ts",
      "test:e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
      "test:e2e:visual:only": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "npm run build && playwright test e2e/visual.spec.ts --update-snapshots=all",
      "spike:e": "tsx spikes/e-model-switch.ts",
      "spike:f": "tsx --env-file-if-exists=.env spikes/f-ssh-remote-kernel.ts",
      "smoke:remote": "tsx --env-file-if-exists=.env spikes/g-remote-executor.ts",
      "rehearse:fresh": "node scripts/rehearse-fresh-install.mjs"
    }
  },

  "build": {
    "buildCommand": "python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"e2e/cli-agent.spec.ts\"); s = p.read_text(encoding=\"utf8\")\n# 用「默认配置」而非自带的，验的才是发出去的那份\ns = s.replace('''  test(\"**你自己说的话也要在对话里**''', '''  test(\"**模型选择器真的出现** —— 上一轮就是漏了这一条，发了个哑的出去\", async ({ dawn }) => {\n    const { page } = dawn\n    await startFakeClaude(page)\n    /**\n     * 它的渲染条件是「有清单 **且** 知道当前是哪个」。\n     * 只声明 `models` 不声明 `model` 时，**整个选择器不渲染**——\n     * 而单元测试当时只断言了 `models`，于是那一半悄悄坏掉，\n     * 作者试用时看到的是「好像没有任何变化」。\n     */\n    await expect(page.getByRole(\"button\", { name: /^sonnet/ })).toBeVisible()\n  })\n\n  test(\"**你自己说的话也要在对话里**''')\ns = s.replace('''    model: sonnet\n    models: [sonnet, opus, haiku]\n    capabilities: [chat, exec]''', '''    model: sonnet\n    models: [sonnet, opus, haiku]\n    capabilities: [chat, exec]''')\n# 给假 claude 的 agent 定义补上 model/models\ns = s.replace('''  claude:\n    kind: cli\n    command: \"${FAKE}\"\n    args: []\n    capabilities: [chat, exec]''', '''  claude:\n    kind: cli\n    command: \"${FAKE}\"\n    args: []\n    model: sonnet\n    models: [sonnet, opus, haiku]\n    capabilities: [chat, exec]''')\np.write_text(s, encoding=\"utf8\")\nPY\ngrep -n \"model:\" e2e/cli-agent.spec.ts | head -3; npm run build 2>&1 | tail -1 && npx playwright test e2e/cli-agent.spec.ts --reporter=list 2>&1 | grep -E \"✓|✘|passed|failed\" | head -8",
    "testCommand": "python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"tests/first-run.test.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''  it(\"**cli agent 带模型清单** —— 没有它就没有模型选择器（Spike H）\", () => {\n    const reg = parsed()\n    expect(reg.agents[\"claude\"]).toMatchObject({ models: expect.arrayContaining([\"sonnet\"]) })\n    expect(reg.agents[\"codex\"]).toMatchObject({ models: expect.any(Array) })\n  })''', '''  /**\n   * **2026-08-09：这条测试原来是不够的。**\n   *\n   * 它只断言了 `models`（清单），而选择器的渲染条件是\n   * 「有清单 **且** 知道当前是哪个」。我发出去的默认配置只写了 `models`——\n   * **于是选择器在真机上根本不出现**，作者看到的是「好像没有任何变化」。\n   *\n   * **一条只验了一半条件的断言，会让另一半悄悄坏掉。**\n   */\n  it(\"**cli agent 的 model 与 models 都要有** —— 少一个选择器就不出现\", () => {\n    const reg = parsed()\n    for (const id of [\"claude\", \"codex\"]) {\n      const a = reg.agents[id] as { model?: string; models?: string[] }\n      expect(a.model, `${id} 缺 model：选择器要知道「当前是哪个」才画得出来`).toBeTruthy()\n      expect((a.models ?? []).length, `${id} 的 models 至少要两项才谈得上「选」`).toBeGreaterThan(1)\n      // 当前那个必须在清单里，否则 pill 上显示的东西选不回来\n      expect(a.models).toContain(a.model)\n    }\n  })''')\np.write_text(s, encoding=\"utf8\")\nPY\nnpm test 2>&1 | grep -E \"Tests |FAIL\" | tail -2; npm run typecheck 2>&1 | grep -c \"error TS\"",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test",
      "test:e2e:only": "playwright test",
      "test:e2e:visual": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
      "spike:e": "tsx spikes/e-model-switch.ts"
    }
  },

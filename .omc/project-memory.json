  "build": {
    "buildCommand": "python3 - <<'PY'\nimport pathlib\n# 假 codex 回显 argv，e2e 才断言得了「换模型真的生效」\np = pathlib.Path(\"e2e/fixtures/codex\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('text: (isResume ? \"假 codex 续接：\" : \"假 codex 首轮：\") + prompt },',\n              'text: (isResume ? \"假 codex 续接：\" : \"假 codex 首轮：\") + prompt + \" argv=\" + argv.join(\" \") },')\np.write_text(s, encoding=\"utf8\")\n\np = pathlib.Path(\"e2e/codex-agent.spec.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''const PROVIDERS = `agents:\n  codex:\n    kind: cli\n    command: \"${FAKE}\"\n    args: []\n    capabilities: [chat, exec]\n`''', '''const PROVIDERS = `agents:\n  codex:\n    kind: cli\n    command: \"${FAKE}\"\n    args: []\n    model: gpt-5.1-codex\n    models: [gpt-5.1-codex, gpt-5.1-codex-mini]\n    capabilities: [chat, exec]\n`''')\ns = s.rstrip(\"\\n\") + '''\n\ntest.describe(\"在一个对话里换模型（作者试用后补）\", () => {\n  test.use({ dawnOptions: { providersYaml: PROVIDERS, gitInit: true } })\n\n  /**\n   * **作者报的那件事**：*「我的一个对话里面，不能切换不同的模型。\n   * 点击新的模型之后，就默认的跳入新的对话里面了。」*\n   *\n   * 根因不是坏了，是没做——cli 会话里没有模型选择器，\n   * 只有 agent pill，而它点了必然新建会话。\n   */\n  test(\"**换完之后是同一个对话，且下一轮真的用了新模型**\", async ({ dawn }) => {\n    const { page, dbPath } = dawn\n    await startCodex(page)\n    await say(page, \"第一句\")\n    await expect(page.getByText(/假 codex 首轮/)).toBeVisible({ timeout: 30_000 })\n\n    // 模型选择器在 composer 右下角——**它存在本身就是这次修的东西**\n    await page.getByRole(\"button\", { name: /gpt-5\\\\.1-codex$/ }).click()\n    await page.getByRole(\"menuitem\", { name: /gpt-5\\\\.1-codex-mini/ }).click()\n\n    await say(page, \"第二句\")\n    // **同一个对话**：第一句仍在，且第二轮走的是 resume（续接）\n    await expect(page.getByText(/假 codex 首轮：第一句/)).toBeVisible()\n    await expect(page.getByText(/假 codex 续接：第二句/)).toBeVisible({ timeout: 30_000 })\n    // **新模型真的传下去了**\n    await expect(page.locator(\".turn.agent\").last()).toContainText(\"--model gpt-5.1-codex-mini\")\n\n    // 而且**没有新建会话**\n    const { default: Database } = await import(\"better-sqlite3\")\n    const db = new Database(dbPath, { readonly: true })\n    const n = (db.prepare(\"SELECT COUNT(*) c FROM sessions\").get() as { c: number }).c\n    db.close()\n    expect(n).toBe(1)\n  })\n})\n'''\np.write_text(s, encoding=\"utf8\")\nPY\nnpm run build 2>&1 | tail -1 && npx playwright test e2e/codex-agent.spec.ts --reporter=list 2>&1 | grep -E \"✓|✘|passed|failed|Received\" | head -8",
    "testCommand": "python3 - <<'PY'\nimport pathlib, os\ncfg = pathlib.Path(os.environ[\"HOME\"]) / \"Library/Application Support/Electron/providers.yaml\"\ns = cfg.read_text(encoding=\"utf8\")\nif \"models:\" not in s:\n    s = s.replace(\"\"\"  claude:\n    kind: cli\n    command: claude\"\"\", \"\"\"  claude:\n    kind: cli\n    command: claude\n    # 模型选择器里能选哪些。两个 CLI 都没有「列出可选项」的接口，只能在这里写\n    models: [sonnet, opus, haiku]\"\"\")\n    s = s.replace(\"\"\"  codex:\n    kind: cli\n    command: codex\"\"\", \"\"\"  codex:\n    kind: cli\n    command: codex\n    models: [gpt-5.1-codex, gpt-5.1-codex-mini]\"\"\")\n    cfg.write_text(s, encoding=\"utf8\")\n    print(\"你的配置已补上 models\")\nelse:\n    print(\"已有 models，未改动\")\nPY\ncp /dev/null /tmp/v.ts; cat > tests/config/_v.test.ts <<'EOF'\nimport { it, expect } from \"vitest\"\nimport { join } from \"node:path\"\nimport { loadRegistry } from \"../../src/config/loader.js\"\nit(\"作者配置仍可加载，且带模型清单\", () => {\n  const reg = loadRegistry(join(process.env.HOME!, \"Library/Application Support/Electron/providers.yaml\"))\n  console.log(\"agents:\", Object.entries(reg.agents).map(([k, v]) => `${k}=${v.kind}${\"models\" in v && v.models ? \"(\" + v.models.join(\"/\") + \")\" : \"\"}`).join(\"  \"))\n  expect(reg.agents[\"claude\"]).toMatchObject({ kind: \"cli\" })\n})\nEOF\nnpx vitest run tests/config/_v.test.ts --reporter=verbose 2>&1 | grep -E \"agents:|Tests |×\" | head -3; rm -f tests/config/_v.test.ts",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test",
      "test:e2e:only": "playwright test",
      "test:e2e:visual": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
      "spike:e": "tsx spikes/e-model-switch.ts"
    }

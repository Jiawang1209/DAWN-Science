 .collaboration-root-node { position: absolute; width: 220px; min-height: 122px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; gap: var(--dawn-space-2); border: var(--dawn-hairline) solid var(--dawn-stroke-1); background: var(--dawn-surface-elevated); border-radius: var(--dawn-radius-md); padding: var(--dawn-space-3); }

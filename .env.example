# DAWN Science —— 本地环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后把 .env 里的占位值换成真实值。
#
# .env 已被 .gitignore 排除（第 31 行），永远不会进版本库。
# 本文件（.env.example）会进版本库，所以**只放占位符，绝不放真实密钥**。

# ── 模型 endpoint 凭证 ────────────────────────────────────────
# providers.yaml 里写 `apiKey: ${DEEPSEEK_API_KEY}`，由 config/loader.ts 展开。
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填你的真实key

# 以下按需启用（暂未使用可保持注释）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=

# ── 运行时开关 ────────────────────────────────────────────────
# 配置文件路径，默认 providers.example.yaml
# DAWN_CONFIG=providers.yaml

# SQLite 数据库路径，默认 .dawn.db
# DAWN_DB=.dawn.db

# Spike D 用的 Jupyter kernelspec 名称，默认 dawn-spike
# DAWN_KERNEL=dawn-spike

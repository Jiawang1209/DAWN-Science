  "build": {
    "buildCommand": "cd /Users/liuyue/Desktop/Github_repos/dawn-science\npython3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"src/ui/Settings.tsx\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''        <p className=\"hint\">**没有配置就不能用**——配置里 `kind: kernel` 的 agent 靠这两个路径起内核。</p>''',\n'''        {/* **JSX 纯文本不渲染 markdown**——写 `**` 只会原样显示成星号。\n            今天第二次栽在这上面（第一次在陈旧标记那句），所以强调放进 CSS */}\n        <p className=\"hint kernel-note\">\n          没有配置就不能用：配置里 kind: kernel 的 agent 靠这两个路径起内核。\n        </p>''', 1)\np.write_text(s, encoding=\"utf8\")\n\np = pathlib.Path(\"src/ui/styles.css\"); c = p.read_text(encoding=\"utf8\")\nc = c.rstrip(\"\\n\") + '''\n\n/* ── 解释器路径（2026-08-10）───────────────────────────────────────── */\n/* 「没有配置就不能用」是机制本身，不是补充说明——所以它要比普通提示醒目 */\n.kernel-note { color: var(--dawn-text-2); }\n/* 保存按钮不许被输入框挤成两行 */\n.cred-form .btn { flex: 0 0 auto; white-space: nowrap; }\n/* 参考区默认收起：它只是帮人填上面那两个框，不该占主视野 */\n.kernel-ref { margin-top: var(--dawn-space-3); }\n.kernel-ref summary { color: var(--dawn-text-3); font-size: 12px; cursor: pointer; }\n'''\np.write_text(c, encoding=\"utf8\")\nPY\nnpm run build >/dev/null 2>&1 && npm run test:e2e:visual:update 2>&1 | grep -E \"passed|failed\" | tail -1",
    "testCommand": "cd /Users/liuyue/Desktop/Github_repos/dawn-science\npython3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"tests/protocol/operations.test.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('it(\"25 个操作齐全（原冻结 13 + 凭证 3 + getProviders 1 + 订阅 2 + 中止与引导 2 + 换模型 1 + 上下文用量 1 + 列内核 1 + 列变量 1）\", () => {',\n              'it(\"27 个操作齐全（… + 列内核 1 + 列变量 1 + 解释器路径 2）\", () => {', 1)\ns = s.replace('        \"getProvenance\",', '        \"getInterpreters\",\\n        \"getProvenance\",', 1)\ns = s.replace('        \"setSessionModel\",', '        \"setInterpreter\",\\n        \"setSessionModel\",', 1)\np.write_text(s, encoding=\"utf8\")\n\np = pathlib.Path(\"tests/protocol/events.test.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('describe(\"协议版本 · 2.8\", () => {', 'describe(\"协议版本 · 2.9\", () => {', 1)\ns = s.replace('''   * **2.8（2026-08-10）：新增 `listVariables`（S14）。**''',\n'''   * **2.9（2026-08-10）：新增 `getInterpreters` / `setInterpreter`。**\n   *   两个解释器路径是**调用 Python / R 的机制**（作者定）：没配就不能用，\n   *   而不是退回某个扫描出来的默认。**没配的那个不给字段**，不是空串。\n   *\n   * 2.8（2026-08-10）：新增 `listVariables`（S14）。''', 1)\ns = s.replace('expect(WORKBENCH_PROTOCOL_VERSION).toBe(\"2.8\")', 'expect(WORKBENCH_PROTOCOL_VERSION).toBe(\"2.9\")', 1)\np.write_text(s, encoding=\"utf8\")\nPY\nnpm test 2>&1 | grep -E \"Tests |FAIL|×\" | head -5",

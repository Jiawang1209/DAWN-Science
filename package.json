{
  "name": "dawn-science",
  "version": "0.0.1",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/Jiawang1209/DAWN-Science",
  "private": true,
  "description": "Data Agent Workbench with Notebooks — for science.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
    "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
    "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
    "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
    "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "build:ui": "vite build",
    "build": "npm run build:electron && npm run build:ui",
    "app": "npm run build && electron dist/electron/main.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "pack": "npm run build && electron-builder --dir",
    "test:packaged": "node scripts/test-packaged.mjs",
    "make-icon": "electron scripts/make-icon.mjs",
    "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
    "ui:dev": "vite",
    "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
    "dev:mock": "node scripts/dev-mock.mjs",
    "test:e2e": "npm run build && playwright test --grep-invert \"内核会话|解释器路径\" && playwright test e2e/kernel-session.spec.ts",
    "test:e2e:only": "playwright test --grep-invert \"内核会话|解释器路径\"",
    "test:e2e:kernel": "playwright test e2e/kernel-session.spec.ts",
    "test:e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
    "test:e2e:visual:only": "playwright test e2e/visual.spec.ts",
    "test:e2e:visual:update": "npm run build && playwright test e2e/visual.spec.ts --update-snapshots=all",
    "spike:e": "tsx spikes/e-model-switch.ts",
    "spike:f": "tsx --env-file-if-exists=.env spikes/f-ssh-remote-kernel.ts",
    "smoke:remote": "tsx --env-file-if-exists=.env spikes/g-remote-executor.ts",
    "rehearse:fresh": "node scripts/rehearse-fresh-install.mjs",
    "rehearse:update": "node scripts/rehearse-update.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nanostores/react": "^1.1.0",
    "@nteract/messaging": "^7.0.20",
    "@types/pdfkit": "^0.17.6",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "enchannel-zmq-backend": "^10.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "nanostores": "^1.4.2",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.1",
    "playwright-core": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "shiki": "^4.4.2",
    "simple-git": "^3.36.0",
    "spawnteract": "^5.0.1",
    "ssh2": "^1.17.0",
    "streamdown": "^2.5.0",
    "typebox": "^1.3.11",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.9.0",
    "zeromq": "^6.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

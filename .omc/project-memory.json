  "build": {
    "buildCommand": "python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"e2e/lease-keepalive.spec.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('await expect(page.getByText(\"旧对话的第一句\")).toBeVisible()',\n              '// **在对话区里找**：同一句话也是侧栏那一行的标题，不限定范围会撞上\\n  await expect(page.locator(\".turns\").getByText(\"旧对话的第一句\")).toBeVisible()', 1)\nfor t in [\"过期之后的第二句\", \"回来之后还能说\"]:\n    s = s.replace(f'await expect(page.getByText(\"{t}\")).toBeVisible({{ timeout: 30_000 }})',\n                  f'await expect(page.locator(\".turns\").getByText(\"{t}\")).toBeVisible({{ timeout: 30_000 }})')\np.write_text(s, encoding=\"utf8\")\n\np = pathlib.Path(\"e2e/remote-connections.spec.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''  // 侧栏那一行也挂上了这段对话\n  await expect(row.locator(\".remote-session\")).toHaveCount(1)''',\n'''  /**\n   * 侧栏那一行也挂上了这段对话，**而且用的是与别处同一种行**\n   * （`.sess-item` —— 带删除/改名/置顶/挪位置）。\n   * 作者报过：*「在服务器的对话，不能删除，也不能挪动顺序」*——\n   * 那是因为这里当初图省事画了一个只能点的行。\n   */\n  await expect(row.locator(\".sess-item\")).toHaveCount(1)\n  await expect(row.locator(\".sess-item .sub\")).toHaveText(\"~\")''', 1)\np.write_text(s, encoding=\"utf8\")\n\np = pathlib.Path(\"src/ui/styles.css\"); s = p.read_text(encoding=\"utf8\")\nold = s[s.index(\"/* 这台机器上的对话（②-B · R4′）。副行是它此刻在哪个目录——**不是装饰** */\"):s.index(\"/* 对话头上那一条：\")]\nnew = \"\"\"/* 这台机器上的对话（②-B · R4′）。\n   **行本身用的是和别处一样的 `SessionRow`**——删除、改名、置顶、挪位置\n   因此自带；作者报过「服务器上的对话不能删除也不能挪动」，那时这里是自绘的一行 */\n.remote-sessions { list-style: none; margin: 2px 0 0; padding: 0 0 0 var(--dawn-space-2); }\n\"\"\"\ns = s.replace(old, new, 1)\np.write_text(s, encoding=\"utf8\")\nPY\nnpm run build >/dev/null 2>&1 && npx playwright test e2e/lease-keepalive.spec.ts e2e/remote-connections.spec.ts 2>&1 | tail -5",
    "testCommand": "npm test 2>&1 | grep -E \"Tests |FAIL\" | head -3; npm run test:e2e:only 2>&1 | tail -8",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test --grep-invert \"内核会话|解释器路径\" && playwright test e2e/kernel-session.spec.ts",
      "test:e2e:only": "playwright test --grep-invert \"内核会话|解释器路径\"",
      "test:e2e:kernel": "playwright test e2e/kernel-session.spec.ts",
      "test:e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
      "test:e2e:visual:only": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "npm run build && playwright test e2e/visual.spec.ts --update-snapshots",
      "spike:e": "tsx spikes/e-model-switch.ts"
    }
  },

{
  "name": "dawn-science",
  "version": "0.0.1",
  "private": true,
  "description": "Data Agent Workbench with Notebooks — for science.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
    "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
    "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
    "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nteract/messaging": "^7.0.20",
    "better-sqlite3": "^13.0.3",
    "enchannel-zmq-backend": "^10.0.0",
    "node-pty": "^1.1.0",
    "rxjs": "^7.8.2",
    "simple-git": "^3.36.0",
    "spawnteract": "^5.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

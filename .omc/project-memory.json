  "build": {
    "buildCommand": "cd /Users/liuyue/Desktop/Github_repos/dawn-science; cat > e2e/task.spec.ts <<'EOF'\n/**\n * 新建任务（T2/T3）。**跑真实构建产物。**\n *\n * 作者：*「我也要 workbuddy 的新建任务……如果在任务里面不设置任何工作目录的话，\n * 那么其实就是我们的普通对话。」*\n *\n * 所以这条盯的是**那句话本身**：点一下，不问路径，直接能聊。\n */\nimport { test, expect } from \"./fixtures.js\"\n\ntest(\"**点「新建任务」就能聊** —— 不问工作路径\", async ({ dawn }) => {\n  const { page } = dawn\n\n  await page.getByRole(\"button\", { name: \"新建任务\" }).click()\n\n  // 建完就进对话——**不该让人再点一次才进得去**\n  await expect(page.getByPlaceholder(/回车发送/)).toBeVisible({ timeout: 30_000 })\n\n  await page.getByPlaceholder(/回车发送/).fill(\"你好\")\n  await page.getByRole(\"button\", { name: \"发送\", exact: true }).click()\n  await expect(page.locator(\".turns\")).toContainText(\"假模型已应答\", { timeout: 30_000 })\n  // 写权那条路也要通——它此前在四个地方各写了一遍，漏一个就是「点了没反应」\n  await expect(page.getByText(/写入被拒/)).toHaveCount(0)\n})\n\ntest(\"**任务出现在侧栏，且不显示那个用户没选过的目录**\", async ({ dawn }) => {\n  const { page } = dawn\n  await page.getByRole(\"button\", { name: \"新建任务\" }).click()\n  await expect(page.getByPlaceholder(/回车发送/)).toBeVisible({ timeout: 30_000 })\n\n  const 行 = page.locator(\".task-row\")\n  await expect(行).toHaveCount(1)\n  await expect(page.getByText(/^任务/)).toBeVisible()\n\n  /**\n   * **没设路径 = 普通对话，那一格什么都不写。**\n   *\n   * 服务端确实给了它一个目录（agent 要能读写），但那是实现细节——\n   * 摆出来只会让人看见一个自己从没选过的路径，\n   * 而那正是此前「临时会话」让人困惑的地方。\n   */\n  await expect(行.locator(\".task-ws\")).toHaveCount(0)\n})\nEOF\nnpm test 2>&1 | grep -E \"Tests |FAIL\" | head -2; npm run build >/dev/null 2>&1 && npx playwright test e2e/task.spec.ts 2>&1 | grep -E \"passed|failed\" | tail -2",
    "testCommand": "npm test 2>&1 | tail -8",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test --grep-invert \"内核会话|解释器路径\" && playwright test e2e/kernel-session.spec.ts",
      "test:e2e:only": "playwright test --grep-invert \"内核会话|解释器路径\"",
      "test:e2e:kernel": "playwright test e2e/kernel-session.spec.ts",
      "test:e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
      "test:e2e:visual:only": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "npm run build && playwright test e2e/visual.spec.ts --update-snapshots",
      "spike:e": "tsx spikes/e-model-switch.ts",
      "spike:f": "tsx --env-file-if-exists=.env spikes/f-ssh-remote-kernel.ts",
      "smoke:remote": "tsx --env-file-if-exists=.env spikes/g-remote-executor.ts"
    }

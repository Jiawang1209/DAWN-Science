    "buildCommand": "cd /Users/liuyue/Desktop/Github_repos/dawn-science\nrm -f e2e/probe.spec.ts\nnpm run build >/dev/null 2>&1\nnpm run test:e2e:only 2>&1 | grep -E \"^\\s+[0-9]+ (passed|failed|skipped)|✘\" | tail -6",
    "testCommand": "cd /Users/liuyue/Desktop/Github_repos/dawn-science\ncp src/ui/styles.css /tmp/s.bak\nfor 类 in perm-choice skill-name usage-rank; do\n  python3 -c \"\nimport sys\np='src/ui/styles.css';s=open(p).read()\nopen(p,'w').write('\\n'.join(l for l in s.split('\\n') if sys.argv[1] not in l))\" $类\n  echo -n \"删掉 .$类 → \"\n  npx vitest run tests/ui/design-contract.test.ts 2>&1 | grep -cE \"×.*JSX 里的类名\" | tr -d '\\n'; echo \" 处红\"\n  cp /tmp/s.bak src/ui/styles.css\ndone\nnpm test 2>&1 | grep -E \"Test Files|Tests |×\" | tail -3",
    "lintCommand": null,
    "devCommand": null,
    "scripts": {
      "postinstall": "node scripts/fix-node-pty.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "typecheck": "tsc --noEmit",
      "dawn": "tsx --env-file-if-exists=.env src/cli.ts",
      "smoke:native": "tsx --env-file-if-exists=.env scripts/smoke-native.ts",
      "spike:a": "tsx --env-file-if-exists=.env spikes/a-pi-embed.ts",
      "spike:b": "tsx --env-file-if-exists=.env spikes/b-pty-mcp-hook.ts",
      "spike:d": "tsx --env-file-if-exists=.env spikes/d-jupyter-kernel.ts",
      "build:electron": "node scripts/build-electron.mjs",
      "build:ui": "vite build",
      "build": "npm run build:electron && npm run build:ui",
      "app": "npm run build && electron dist/electron/main.js",
      "app:dev": "npm run build:electron && DAWN_DEV_SERVER=http://localhost:5273 electron dist/electron/main.js",
      "ui:dev": "vite",
      "spike:a2": "tsx --env-file-if-exists=.env spikes/a2-pi-third-layer.ts",
      "dev:mock": "node scripts/dev-mock.mjs",
      "test:e2e": "npm run build && playwright test --grep-invert \"内核会话|解释器路径\" && playwright test e2e/kernel-session.spec.ts",
      "test:e2e:only": "playwright test --grep-invert \"内核会话|解释器路径\"",
      "test:e2e:kernel": "playwright test e2e/kernel-session.spec.ts",
      "test:e2e:visual": "npm run build && playwright test e2e/visual.spec.ts",
      "test:e2e:visual:only": "playwright test e2e/visual.spec.ts",
      "test:e2e:visual:update": "npm run build && playwright test e2e/visual.spec.ts --update-snapshots",
      "spike:e": "tsx spikes/e-model-switch.ts",
      "spike:f": "tsx --env-file-if-exists=.env spikes/f-ssh-remote-kernel.ts",
      "smoke:remote": "tsx --env-file-if-exists=.env spikes/g-remote-executor.ts"
    }

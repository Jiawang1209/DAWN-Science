  "build": {
    "buildCommand": "python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"tests/first-run.test.ts\"); s = p.read_text(encoding=\"utf8\")\nstart = s.index(\"  /**\\n   * **2026-08-09：这条测试原来是不够的。**\")\nend = s.index('  it(\"内置 agent 仍在')\ns = s[:start] + '''  /**\n   * **2026-08-09 反转过一次。**\n   *\n   * 上一版断言的是「`model` 与 `models` 都要有」，理由是「少一个选择器就不出现」。\n   * **那个断言守着一条错的规则**：写 `model` 就等于给 CLI 传 `--model`，\n   * 会**盖掉用户自己 CLI 的配置**——作者的 claude 默认是 `opus[1m]`、\n   * codex 是 `gpt-5.6-sol`，都被我们盖掉，后者还直接 400。\n   *\n   * **默认配置绝不替用户钉模型。** 现在守的是这一条。\n   */\n  it(\"**默认配置不钉死任何模型** —— 钉了就盖掉用户自己 CLI 的选择\", () => {\n    const reg = parsed()\n    for (const id of [\"claude\", \"codex\"]) {\n      const a = reg.agents[id] as { model?: string }\n      expect(a.model, `${id} 不该有 model：那会覆盖用户自己 CLI 的配置`).toBeUndefined()\n    }\n  })\n\n  it(\"claude 给了模型清单 —— 别名取自 `claude --help`，不是编的\", () => {\n    const a = parsed().agents[\"claude\"] as { models?: string[] }\n    expect(a.models).toEqual(expect.arrayContaining([\"opus\", \"sonnet\"]))\n  })\n\n  it(\"**codex 不给清单** —— 它能用哪些因账号而异，写死一组只会撞 400\", () => {\n    const a = parsed().agents[\"codex\"] as { models?: string[] }\n    expect(a.models).toBeUndefined()\n    // 但要告诉用户去哪查自己的\n    expect(DEFAULT_CONFIG_YAML).toContain(\"model_availability_nux\")\n  })\n\n''' + s[end:]\np.write_text(s, encoding=\"utf8\")\n\n# e2e：不钉 model 时选择器也要出现，且标「CLI 默认」\np = pathlib.Path(\"e2e/cli-agent.spec.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''    model: sonnet\n    models: [sonnet, opus, haiku]\n    capabilities: [chat, exec]''', '''    models: [opus, sonnet, haiku]\n    capabilities: [chat, exec]''')\ns = s.replace('''    await expect(page.getByRole(\"button\", { name: /^sonnet/ })).toBeVisible()''',\n'''    /**\n     * **不钉 `model` 时也要出现**，当前那格标「CLI 默认」。\n     * 钉 `model` 会盖掉用户自己 CLI 的配置——作者两个 CLI 都撞上了。\n     */\n    await expect(page.getByRole(\"button\", { name: /CLI 默认/ })).toBeVisible()''')\np.write_text(s, encoding=\"utf8\")\nPY\nnpm test 2>&1 | grep -E \"Tests |FAIL\" | tail -2 && npm run build 2>&1 | tail -1 && npx playwright test e2e/cli-agent.spec.ts e2e/codex-agent.spec.ts --reporter=list 2>&1 | grep -E \"✓|✘|passed|failed\" | tail -6",
    "testCommand": "python3 - <<'PY'\nimport pathlib\np = pathlib.Path(\"tests/first-run.test.ts\"); s = p.read_text(encoding=\"utf8\")\nstart = s.index(\"  /**\\n   * **2026-08-09：这条测试原来是不够的。**\")\nend = s.index('  it(\"内置 agent 仍在')\ns = s[:start] + '''  /**\n   * **2026-08-09 反转过一次。**\n   *\n   * 上一版断言的是「`model` 与 `models` 都要有」，理由是「少一个选择器就不出现」。\n   * **那个断言守着一条错的规则**：写 `model` 就等于给 CLI 传 `--model`，\n   * 会**盖掉用户自己 CLI 的配置**——作者的 claude 默认是 `opus[1m]`、\n   * codex 是 `gpt-5.6-sol`，都被我们盖掉，后者还直接 400。\n   *\n   * **默认配置绝不替用户钉模型。** 现在守的是这一条。\n   */\n  it(\"**默认配置不钉死任何模型** —— 钉了就盖掉用户自己 CLI 的选择\", () => {\n    const reg = parsed()\n    for (const id of [\"claude\", \"codex\"]) {\n      const a = reg.agents[id] as { model?: string }\n      expect(a.model, `${id} 不该有 model：那会覆盖用户自己 CLI 的配置`).toBeUndefined()\n    }\n  })\n\n  it(\"claude 给了模型清单 —— 别名取自 `claude --help`，不是编的\", () => {\n    const a = parsed().agents[\"claude\"] as { models?: string[] }\n    expect(a.models).toEqual(expect.arrayContaining([\"opus\", \"sonnet\"]))\n  })\n\n  it(\"**codex 不给清单** —— 它能用哪些因账号而异，写死一组只会撞 400\", () => {\n    const a = parsed().agents[\"codex\"] as { models?: string[] }\n    expect(a.models).toBeUndefined()\n    // 但要告诉用户去哪查自己的\n    expect(DEFAULT_CONFIG_YAML).toContain(\"model_availability_nux\")\n  })\n\n''' + s[end:]\np.write_text(s, encoding=\"utf8\")\n\n# e2e：不钉 model 时选择器也要出现，且标「CLI 默认」\np = pathlib.Path(\"e2e/cli-agent.spec.ts\"); s = p.read_text(encoding=\"utf8\")\ns = s.replace('''    model: sonnet\n    models: [sonnet, opus, haiku]\n    capabilities: [chat, exec]''', '''    models: [opus, sonnet, haiku]\n    capabilities: [chat, exec]''')\ns = s.replace('''    await expect(page.getByRole(\"button\", { name: /^sonnet/ })).toBeVisible()''',\n'''    /**\n     * **不钉 `model` 时也要出现**，当前那格标「CLI 默认」。\n     * 钉 `model` 会盖掉用户自己 CLI 的配置——作者两个 CLI 都撞上了。\n     */\n    await expect(page.getByRole(\"button\", { name: /CLI 默认/ })).toBeVisible()''')\np.write_text(s, encoding=\"utf8\")\nPY\nnpm test 2>&1 | grep -E \"Tests |FAIL\" | tail -2 && npm run build 2>&1 | tail -1 && npx playwright test e2e/cli-agent.spec.ts e2e/codex-agent.spec.ts --reporter=list 2>&1 | grep -E \"✓|✘|passed|failed\" | tail -6",

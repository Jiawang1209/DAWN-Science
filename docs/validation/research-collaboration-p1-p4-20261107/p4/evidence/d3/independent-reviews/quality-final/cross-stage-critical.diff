+      const reservation=coordinator.reserveReviewRuns(pipelineBudgetId(current,p),p.round,pipelineRemainingRuns(p))
+      if(reservation?.phase==='recovery-check')coordinator.resumeReviewReservation(reservation.key)
     }
   }
 
